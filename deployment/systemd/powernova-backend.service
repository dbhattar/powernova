[Unit]
Description=PowerNOVA Backend API
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=powernova
Group=powernova
WorkingDirectory=/opt/powernova/backend
Environment=NODE_ENV=production
EnvironmentFile=/opt/powernova/.env
ExecStart=/usr/bin/node src/app.js
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
KillSignal=SIGINT
TimeoutStopSec=20
SyslogIdentifier=powernova-backend
Restart=always
RestartSec=5

# Security settings
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/powernova /var/log/powernova /tmp

# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
