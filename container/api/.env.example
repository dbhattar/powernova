# Environment variables for PowerNOVA API
# Copy this file to .env and fill in your values

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Admin Configuration
ADMIN_KEY=your-secure-admin-key-here

# Server Configuration
PORT=8000
ENVIRONMENT=development

# Database Configuration
DATABASE_URL=postgresql://powernova:powernova_dev_2024@localhost:5432/powernova_db
# For production, use Azure PostgreSQL or managed database:
# DATABASE_URL=postgresql://user:password@your-server.postgres.database.azure.com:5432/powernova_db?sslmode=require

# CORS Origins (comma-separated)
CORS_ORIGINS=https://app.powernova.ai,https://www.powernova.ai,http://localhost:8080,http://localhost:8081

# Logging
LOG_LEVEL=INFO

# Azure Storage (for RAG document storage)
# Get this from Azure Portal > Storage Account > Access keys
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=youraccountname;AccountKey=yourkey;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=powernova-documents

# Document Job Processor Configuration
# Controls background processing of document embeddings
DOC_PROCESSOR_POLL_INTERVAL=10  # Seconds between job queue checks (default: 10)
DOC_PROCESSOR_BATCH_SIZE=10     # Max jobs to process per batch (default: 10)

# Maintenance Mode
MAINTENANCE_MODE=false  # Set to true to enable maintenance mode
