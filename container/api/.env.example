# Environment variables for PowerNOVA API
# Copy this file to .env and fill in your values

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Admin Configuration
ADMIN_KEY=your-secure-admin-key-here

# Server Configuration
PORT=8000
ENVIRONMENT=development

# Database Configuration
DATABASE_URL=postgresql://powernova:powernova_dev_2024@localhost:5432/powernova_db
# For production, use Azure PostgreSQL or managed database:
# DATABASE_URL=postgresql://user:password@your-server.postgres.database.azure.com:5432/powernova_db?sslmode=require

# CORS Origins (comma-separated)
CORS_ORIGINS=https://app.powernova.ai,https://www.powernova.ai,http://localhost:8080,http://localhost:8081

# Logging
LOG_LEVEL=INFO
