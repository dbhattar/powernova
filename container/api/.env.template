# PowerNOVA API Environment Variables Template
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to git!

# ============================================
# OpenAI Configuration (REQUIRED)
# ============================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# ============================================
# Database Configuration
# ============================================
# For local development (Docker):
DATABASE_URL=postgresql://powernova:powernova_dev_2024@localhost:5432/powernova

# For Supabase production (get from Supabase dashboard):
# DATABASE_URL=postgresql://postgres.PROJECT_ID:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# ============================================
# API Configuration
# ============================================
PORT=8000
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# ============================================
# Security
# ============================================
# Generate with: openssl rand -hex 32
SECRET_KEY=dev-secret-key-change-in-production-use-openssl-rand
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:5173

# ============================================
# Database Connection Pooling
# ============================================
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ============================================
# Setup Instructions
# ============================================
# 1. Copy this file: cp .env.template .env
# 2. Edit .env: nano .env
# 3. Add your OpenAI API key
# 4. Start containers: cd ../docker && docker-compose up -d
# 5. Verify: docker exec powernova-api env | grep OPENAI_API_KEY
