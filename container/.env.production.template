# Production Environment - Supabase PostgreSQL
# Copy this to .env.production and fill in your Supabase credentials

# ============================================
# Supabase PostgreSQL Connection
# ============================================

# Get these from: https://app.supabase.com/project/_/settings/database
# Use Connection Pooler for API (port 6543)
DATABASE_URL=postgresql://postgres.PROJECT_ID:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Direct connection for Alembic migrations (port 5432)
DATABASE_URL_DIRECT=postgresql://postgres:[YOUR-PASSWORD]@db.PROJECT_ID.supabase.co:5432/postgres?sslmode=require

# ============================================
# Supabase Project Details (Optional)
# ============================================

# Get these from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# API Configuration
# ============================================

# Application settings
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# CORS (update with your domain)
ALLOWED_ORIGINS=https://powernova.ai,https://www.powernova.ai

# Security
SECRET_KEY=your-secret-key-min-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# Azure Configuration (if needed)
# ============================================

# Azure Storage (for file uploads)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
AZURE_STORAGE_CONTAINER=artifacts

# ============================================
# Connection Pooling
# ============================================

# SQLAlchemy pool settings (conservative for Supabase pooler)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ============================================
# Instructions
# ============================================

# 1. Create Supabase project: https://supabase.com
# 2. Go to Project Settings → Database
# 3. Copy Connection Pooling string (port 6543) → DATABASE_URL
# 4. Copy Direct Connection string (port 5432) → DATABASE_URL_DIRECT
# 5. Go to Project Settings → API
# 6. Copy Project URL → SUPABASE_URL
# 7. Copy anon/public key → SUPABASE_ANON_KEY
# 8. Copy service_role key → SUPABASE_SERVICE_KEY
# 9. Generate SECRET_KEY: openssl rand -hex 32
# 10. Update ALLOWED_ORIGINS with your domain

# Deploy to Azure:
# ./scripts/deploy-api-with-supabase.sh
