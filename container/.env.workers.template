# PowerNOVA Worker Architecture - Environment Variables Template
#
# Copy this file and fill in your actual values
# 
# For local testing:
#   cp .env.workers.template .env.workers
#   # Edit .env.workers with your values
#   source .env.workers
#   ./scripts/test-workers-local.sh
#
# For Azure deployment:
#   cp .env.workers.template .env.workers.azure
#   # Edit .env.workers.azure with your values
#   source .env.workers.azure
#   ./scripts/deploy-workers-azure-aci.sh --test

# =============================================================================
# REQUIRED FOR ALL ENVIRONMENTS
# =============================================================================

# Database Connection (Azure PostgreSQL)
# Format: postgresql://username:password@host:port/database
# Example: postgresql://powernova@myserver:password@myserver.postgres.database.azure.com:5432/powernova
export DATABASE_URL="postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/powernova"

# Azure Blob Storage
# Get this from Azure Portal → Storage Account → Access Keys
export AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net"
export AZURE_STORAGE_CONTAINER_NAME="powernova-documents"

# OpenAI API Key
# Get from: https://platform.openai.com/api-keys
export OPENAI_API_KEY="sk-..."

# =============================================================================
# OPTIONAL - API Configuration
# =============================================================================

# Admin Credentials (auto-generated if not set)
export ADMIN_USERNAME="admin"
export ADMIN_PASSWORD="your-secure-password-here"

# JWT Configuration (auto-generated if not set)
export JWT_SECRET="your-jwt-secret-key-here-min-32-chars"
export JWT_ALGORITHM="HS256"
export JWT_EXPIRATION_MINUTES="1440"  # 24 hours

# =============================================================================
# OPTIONAL - Worker Configuration
# =============================================================================

# Crawler Worker Settings
export POLL_INTERVAL="30"  # Seconds between polls for crawl jobs

# Document Processor Settings
export DOC_PROCESSOR_POLL_INTERVAL="10"  # Seconds between polls
export DOC_PROCESSOR_BATCH_SIZE="10"     # Jobs to process per batch

# Worker Identification (optional, auto-generated if not set)
# export WORKER_ID="my-custom-worker-id"

# =============================================================================
# OPTIONAL - Logging
# =============================================================================

export LOG_LEVEL="INFO"  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# =============================================================================
# OPTIONAL - CORS (for local development)
# =============================================================================

export CORS_ORIGINS="http://localhost,http://localhost:80,http://localhost:8080"

# =============================================================================
# INSTRUCTIONS
# =============================================================================
#
# 1. Copy this file:
#    cp .env.workers.template .env.workers
#
# 2. Fill in your actual values (at minimum: DATABASE_URL, AZURE_STORAGE_*, OPENAI_API_KEY)
#
# 3. Source the file:
#    source .env.workers
#
# 4. Test locally:
#    ./scripts/test-workers-local.sh
#
# 5. Deploy to Azure:
#    ./scripts/deploy-workers-azure-aci.sh --test
#
# =============================================================================
# SECURITY NOTES
# =============================================================================
#
# ⚠️  NEVER commit .env.workers to git!
# ⚠️  Keep your secrets secure
# ⚠️  Use strong passwords for production
# ⚠️  Rotate keys regularly
#
# This template is safe to commit (no actual values)
# Your .env.workers file with real values should be in .gitignore
