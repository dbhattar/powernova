# PowerNOVA Chat App (React) - Local Development Dockerfile
# Multi-stage build: Build React app, then serve with nginx

# Stage 1: Build React app
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY app-react/package*.json ./

# Install dependencies
RUN npm ci

# Copy app source
COPY app-react/ ./

# Build the app with environment variables for local development
ENV VITE_BASE_PATH=/
ENV VITE_API_URL=http://localhost:8000
RUN npm run build

# Stage 2: Serve with nginx
FROM nginx:alpine

# Set working directory
WORKDIR /usr/share/nginx/html

# Remove default nginx files
RUN rm -rf ./*

# Copy nginx configuration (local development - no caching)
COPY docker/nginx-app.local.conf /etc/nginx/conf.d/default.conf

# Copy built React app from builder stage
COPY --from=builder /app/dist .

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost/health || exit 1

# Expose port 80
EXPOSE 80

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
