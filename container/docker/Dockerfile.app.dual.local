# PowerNOVA Dual App - Local Development Dockerfile
# Serves both vanilla JS and React apps

# Stage 1: Build React app
FROM node:20-alpine AS react-builder

WORKDIR /app

# Copy React app files
COPY app-react/package*.json ./
RUN npm ci

COPY app-react/ ./

# Build React app for local development (uses .env.development)
RUN npm run build -- --mode development

# Stage 2: Prepare nginx with both apps
FROM nginx:alpine

# Set working directory
WORKDIR /usr/share/nginx/html

# Remove default nginx files
RUN rm -rf ./*

# Copy nginx configuration (dual app - local development)
COPY docker/nginx-dual-app.local.conf /etc/nginx/conf.d/default.conf

# Copy vanilla JS app (existing)
COPY app/ .

# Replace production config with local config for development
RUN rm -f js/config.js && mv js/config.local.js js/config.js

# Copy React build to /react subdirectory
COPY --from=react-builder /app/dist ./react

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost/health || exit 1

# Expose port 80
EXPOSE 80

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
