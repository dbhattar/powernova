# PowerNOVA API - Production Dockerfile
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies including OpenSSH server and Playwright dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    openssh-server \
    dialog \
    # Playwright browser dependencies
    libglib2.0-0 \
    libnss3 \
    libnspr4 \
    libdbus-1-3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxcb1 \
    libxkbcommon0 \
    libx11-6 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    libatspi2.0-0 \
    libexpat1 \
    && rm -rf /var/lib/apt/lists/*

# Copy SSH configuration and entrypoint
COPY docker/sshd_config /etc/ssh/
COPY docker/entrypoint.sh ./

# Start and enable SSH
RUN echo "root:Docker!" | chpasswd \
    && chmod +x ./entrypoint.sh \
    && cd /etc/ssh/ \
    && ssh-keygen -A

# Copy requirements first for better caching
COPY api/requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Install Playwright browsers (skip install-deps since we already installed system deps manually)
RUN playwright install chromium

# Copy application code explicitly
# Note: Build context is now project root, so we prefix with api/
COPY api/main.py .
COPY api/routes/ ./routes/
COPY api/models/ ./models/
COPY api/database/ ./database/
COPY api/services/ ./services/
COPY api/monitoring/ ./monitoring/
COPY api/alembic/ ./alembic/
COPY api/alembic.ini ./alembic.ini
COPY api/startup.sh ./startup.sh
COPY api/workers/ ./workers/

# Make startup script executable
RUN chmod +x ./startup.sh

# Verify files were copied (for debugging)
RUN echo "=== Files in /app ===" && ls -la /app && \
    echo "=== Files in /app/routes ===" && ls -la /app/routes && \
    echo "=== Files in /app/services ===" && ls -la /app/services && \
    echo "=== Files in /app/workers ===" && ls -la /app/workers

# Create non-root user for security
RUN useradd -m -u 1000 apiuser && \
    chown -R apiuser:apiuser /app

# Note: We need to run as root for SSH daemon
# USER apiuser

# Expose ports (8000 for API, 2222 for SSH)
EXPOSE 8000 2222

# Note: Health check removed from Dockerfile
# For API container, health check is configured in the deployment template
# Worker containers don't need health checks (no HTTP server)

# Use startup.sh as entrypoint for automatic migrations, then start SSH and API
ENTRYPOINT ["./startup.sh"]
CMD ["./entrypoint.sh"]
