# Local Development Environment - PostgreSQL Container
# Copy this to .env.local for local development

# ============================================
# Local PostgreSQL Connection
# ============================================

# Uses docker-compose PostgreSQL container
DATABASE_URL=postgresql://powernova:powernova123@localhost:5432/powernova_db

# ============================================
# API Configuration
# ============================================

# Application settings
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# CORS (allow all for local dev)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# Security (dev only - don't use in production)
SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================
# Connection Pooling
# ============================================

# SQLAlchemy pool settings for local PostgreSQL
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ============================================
# Local Storage (if needed)
# ============================================

# Local file uploads directory
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760  # 10MB

# ============================================
# Instructions
# ============================================

# 1. Start local PostgreSQL:
#    docker-compose up -d db
#
# 2. Run migrations:
#    export DATABASE_URL="postgresql://powernova:powernova123@localhost:5432/powernova_db"
#    alembic upgrade head
#
# 3. Start API:
#    uvicorn api.main:app --reload
